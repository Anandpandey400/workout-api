    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",

        "rootDir": "src",
        "outDir": "dist",

        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": false,

        "types": ["node"], // ⭐ THIS FIXES process
        "skipLibCheck": true
    },
    "include": ["src"]
}
